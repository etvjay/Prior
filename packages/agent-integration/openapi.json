    "/v1/forecast-submissions": {
      "post": {
        "operationId": "submitSignedForecast",
        "description": "Existing signed/provider relay boundary. This local package accepts FIXTURE_KECCAK_V1 only; EIP712_V2 is handled by the existing Forecast Provider server boundary. No arbitrary execution.",
