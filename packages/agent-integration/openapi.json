{
  "openapi": "3.0.3",
  "info": {
    "title": "Prior Agent Integration",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "priorScopes": {
        "type": "apiKey",
        "in": "header",
        "name": "x-prior-scope",
        "description": "Comma-separated prior:read and/or prior:forecast:submit scopes"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset",
          "nextOffset"
        ],
        "properties": {
          "items": {
            "type": "array"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "nextOffset": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  },
